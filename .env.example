# Database (local) / Docker also needs POSTGRES_PASSWORD for compose
DATABASE_URI=postgresql://fabula:secret@localhost:5432/fabulaone
POSTGRES_PASSWORD=change-me-strong-db-password

# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string-in-production

# Redis
REDIS_URL=redis://localhost:6379

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true

# Yandex Object Storage
YOS_ENDPOINT=https://storage.yandexcloud.net
YOS_REGION=ru-central1
YOS_BUCKET=fabulaone-audio
YOS_ACCESS_KEY_ID=
YOS_SECRET_ACCESS_KEY=
# Signed URL lifetime in seconds (default 3600 = 1h)
YOS_SIGNED_URL_TTL=3600

# App
NEXT_PUBLIC_SITE_URL=https://fabulaone.ru
# Used server-side for internal API calls and webhook URL construction
SITE_URL=https://fabulaone.ru

# Email (SMTP)
SMTP_HOST=smtp.unisender.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fabulaone.ru
EMAIL_FROM_NAME=FABULA ONE
ADMIN_EMAIL=admin@fabulaone.ru

# Magic link JWT secret (separate from Payload secret)
MAGIC_LINK_SECRET=change-me-to-another-long-random-string

# Partner cookie / attribution window in days
AFFILIATE_WINDOW_DAYS=30

# Price of PERSONAL order in RUB (used by /api/checkout/personal)
PERSONAL_PRICE=9900

# Yandex Metrika counter ID (optional, omit to disable)
NEXT_PUBLIC_YM_ID=
